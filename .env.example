# Copy to .env (never commit .env). The bot reads these from the environment and never logs them.
DATABENTO_API_KEY=db-xxxxxxxxxxxxxxxxxxxxxxxx
# Optional: Discord/Slack-compatible webhook for entry/exit/error alerts
ALERT_WEBHOOK_URL=
# Leave unset. Live trading additionally needs mode: live, --live and a typed confirmation.
# NQBOT_ENABLE_LIVE=
# TradingView webhook shared secret (>= 24 random characters). Generate one with:
#   py -c "import secrets; print(secrets.token_urlsafe(32))"
WEBHOOK_SECRET=
